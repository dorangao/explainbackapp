# Obtain a key from the Meta Model API dashboard via https://dev.meta.ai/.
# Keep the real value out of chat, source files, and browser bundles.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Optional local developer console. 0 (default) disables capture and data access.
# Enabling exposes checked context and marks all sessions as developer demos.
EXPLAINBACK_TRACE=0

# Optional Ollama origin; use your LAN host in ignored .env.local. Any tag you have pulled
# works here, including Muse Glimmer and a Muse Spark Open build (open weights, self-hosted).
OLLAMA_BASE_URL=http://localhost:11434
EXPLAINBACK_OLLAMA_MODELS=muse-glimmer:latest,qwen3.8:27b
# Optional comma-separated Meta models; defaults to META_MODEL plus muse-spark-1.3 and muse-wonder-1.0.
# EXPLAINBACK_META_MODELS=muse-spark-1.3,muse-wonder-1.0
# Provider prefix plus exact model name, fixed for each new session.
EXPLAINBACK_DEFAULT_MODEL=meta:muse-spark-1.3

# Local development only: 1 skips sign-in on the localhost server (npm run dev:open).
# The Vercel build ignores this flag. Default 0 keeps the tester login required.
EXPLAINBACK_OPEN_ACCESS=0

# Required shared tester login. Use a unique password of 12–512 characters.
# Missing credentials disable access; server environment overrides .env.local.
EXPLAINBACK_TESTER_USERNAME=tester
EXPLAINBACK_TESTER_PASSWORD=

# Optional reviewer access codes: label:CODE:expiry(YYYY-MM-DD, UTC):requests-per-hour, comma-separated.
# A code signs in without the password (login form or https://host/#invite:CODE), has its own hourly
# action budget, expires at the end of its date, and is revoked by removing it here and redeploying.
# Everyone using one label shares its hourly budget and can edit or delete lessons on its shelf.
# Use separate labels where independent budgets and shelves are needed. A budget unit may trigger
# multiple provider calls; it is not a spend cap. See docs/architecture.md for session/update behavior.
# Codes are 8-64 letters/digits/hyphens; malformed entries are skipped with a positional warning.
EXPLAINBACK_ACCESS_CODES=

# Vercel uses muse-spark only and requires shared Redis session storage.
# Configure these as server-only Vercel variables, never browser/public variables.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional Vercel Blob store for image bytes: show covers, slide illustrations and the sketch a
# lesson was created from are kept with saved lessons as public, unguessable URLs. Without it,
# images stay in the browser for the session and are dropped when a lesson is saved.
# BLOB_READ_WRITE_TOKEN=
# Optional HTTPS custom-domain origins; Vercel deployment/branch hosts are automatic.
# EXPLAINBACK_PUBLIC_ORIGINS=https://your-domain.example
# Optional local provider allowlist (Vercel always forces meta).
# EXPLAINBACK_PROVIDERS=meta,ollama
