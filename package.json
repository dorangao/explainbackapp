{
  "name": "explainback-hackathon-submission",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Doran Gao",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:open": "EXPLAINBACK_OPEN_ACCESS=1 node --env-file-if-exists=.env.local scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env.local src/server.mjs",
    "eval:live": "node --env-file-if-exists=.env.local scripts/evaluate.mjs",
    "claim:smoke": "node --env-file-if-exists=.env.local scripts/claim-smoke.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "build": "node scripts/build-vercel.mjs",
    "eval:models": "node --env-file-if-exists=.env.local scripts/compare-models.mjs",
    "eval:studio": "node --env-file-if-exists=.env.local scripts/eval-studio.mjs",
    "shows:gallery": "node --env-file-if-exists=.env.local scripts/make-gallery-shows.mjs",
    "llm:recover": "node --env-file-if-exists=.env.local scripts/recover-ollama.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:browser": "playwright test",
    "lint": "oxlint frontend e2e vite.config.ts vitest.config.ts playwright.config.ts",
    "format": "prettier --write frontend e2e *.ts",
    "format:check": "prettier --check frontend e2e *.ts",
    "test:unit": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:unit",
    "typecheck:app": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "express": "5.3.0",
    "openai": "7.45.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
